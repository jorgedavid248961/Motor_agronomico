DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# API territorial canónica (API_CANONICA): de ahí salen NDVI, lluvia y suelos. En local: http://127.0.0.1:8001
TERRITORIAL_API_URL=http://127.0.0.1:8001
# Opcional: tiempo máximo de espera por operación de red con esa API (segundos)
TERRITORIAL_API_TIMEOUT=120
CORS_ORIGINS=https://hackaton-2026-liard.vercel.app,http://localhost:3000
CORS_ORIGIN_REGEX=https://hackaton-2026-.*\.vercel\.app
# Si se define, POST /api/v1/evaluaciones exige la cabecera X-API-Key con este valor.
API_KEY=
